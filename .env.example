APP_ENV=development
DATABASE_URL=postgresql+psycopg://jobhunter:local@db:5432/jobhunter
REDIS_URL=redis://redis:6379/0
API_TOKEN=
JOB_SEARCH_TIMEZONE=America/Bahia
JOB_SEARCH_CRON=0 8 * * *
MATCH_PREPARE_THRESHOLD=75
EMAIL_SEND_ENABLED=false
EMAIL_DAILY_LIMIT=10
STORAGE_ROOT=./var/private

DISCOVERY_MODE=disabled
# Set live for Remotive, fixture for offline demonstration, disabled to stop discovery.
# Empty profile ID uses the only non-demo profile with an active resume template.
DISCOVERY_PROFILE_ID=
DISCOVERY_ROLES=frontend,front end,backend,back end,fullstack,full stack,react native,expo,software engineer,software developer

# Enable only after separate Google OAuth consent and choosing the target spreadsheet.
SHEETS_SYNC_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

RESUME_STORAGE_ROOT=var/private/resumes

# Enabled in the Docker runtime; local hosts may keep rendering disabled.
RESUME_RENDER_ENABLED=true
LIBREOFFICE_BINARY=/usr/bin/libreoffice

# Optional stable browser-session secret, at least 32 random characters.
UI_SESSION_SECRET=
UI_COOKIE_SECURE=false
