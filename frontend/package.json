{
  "name": "job-hunter-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
